dAVgxODIO6NgYLQ6m_x1MZgywjGvxQzyI9S0dhSHLo363iW.jpg?_nc_cat=103\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-arn2-1.xx.fbcdn.net\u0026_nc_ohc=3ucI6lCpudcQ7kNvwFJB6ra\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=_U7Xtb9zee--ohvQab6aeA\u0026_nc_zt=14\u0026_nc_ss=7b289\u0026oh=00_AQKb8_WYKMOPOOLo1U0dQuS6thHWaIbeza9VKlUoO1uzzg\u0026oe=6ABD5355\",\"placeholderThumbnailUri\":null,\"capabilities\":[\"IMAGINE\"],\"isVideo\":false,\"category\":\"image\",\"attachmentType\":\"MEDIA_PICKER\",\"multipleAttachments\":false,\"suggestedAttachmentCount\":1,\"mediaPickerSubtitle\":\"Select a photo of a room\",\"promptText\":\"Create an isometric 3D diorama image of this uploaded room photo, orthographic, no perspective. Stylised toy-like, soft matt felt/wood, rounded, low-poly smooth. Warm diffuse light, AO. Not photorealistic. White background, centred.\",\"segments\":[{\"type\":\"static\",\"text\":\"Create an isometric 3D diorama image of this uploaded room photo, orthographic, no perspective. Stylised toy-like, soft matt felt/wood, rounded, low-poly smooth. Warm diffuse light, AO. Not photorealistic. White background, centred.\"}],\"userInputSteps\":[{\"stepType\":\"IMAGE_PICKER\",\"suggestedMediaCount\":1,\"textSuggestions\":[],\"title\":\"Choose an image\"}]}]\n"])</script><script nonce="">self.__next_f.push([1,"82:{\"data\":{\"conversationStartersByType\":[{\"id\":\"794816423626336\",\"text\":\"Show me and my future self\",\"longPrompt\":\"Generate an image of me and my future self in 30 years, looking at camera, heads slightly tilted toward each other, in a photograph. Put my future self in different clothes, something more age appropriate but that pairs well with my outfit.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1694156332332264\",\"text\":\"Make an exploded view diagram from this photo\",\"longPrompt\":\"Make an exploded view diagram of the attached image.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1761226631677884\",\"text\":\"Imagine me paragliding\",\"longPrompt\":\"Use my photo to place me paragliding over a stunning exotic landscape. Make it a medium-high angled action-camera close-up selfie from mid-chest up, with my face, goggles on, and shoulders filling most of the frame. Show the parachute canopy at the top, wide-angle lens distortion, harness straps visible across my chest, and me wearing a paragliding helmet and goggles, full flight suit, and a 'wow' expression as I look out across the landscape.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"2068324373733161\",\"text\":\"Discover home decor trends\",\"longPrompt\":\"What are the home decor trends that are blowing up on Instagram\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"TRENDING\",\"responseDisplayMode\":\"full_prompt\"}]}}\n"])</script><script nonce="">$RC("B:17","S:17")</script><script nonce="">self.__next_f.push([1,"85:{\"data\":{\"conversationStartersByType\":[]}}\n"])</script><script nonce="">$RC("B:1a","S:1a")</script><script nonce="">self.__next_f.push([1,"84:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1054920313721097\",\"text\":\"GIF me macarena\",\"longPrompt\":\"Make a smooth 6 fps gif of me doing the Macarena dance, smiling, dressed in bright, loose 90s clothes you can move in: Right arm forward palm down, left arm forward palm down, flip both palms up, right hand to left shoulder, left to right shoulder, right hand behind head, left behind head, hands to front hips, then back hips, wiggle and quarter turn left jump.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1944103966295089\",\"text\":\"Plan a 5-day road trip for me\",\"longPrompt\":\"Based on what you know about me, plan a 5-day ideal roadtrip and present it as a vintage travel brochure with illustrated maps and daily highlights.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"2429899750841983\",\"text\":\"GIF me a break in the pool\",\"longPrompt\":\"Generate a smooth looping 6 FPS animated gif of me as a stop-motion plasticine character relaxing in a pool wearing an inflatable pink flamingo floater, Hawaiian shirt and sunglasses. Animate like a classic plasticine stop-motion movement. Every frame must have the identical character body, colors, and outline.\",\"type\":\"imagine\",\"attachment_type\":\"NONE\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1934431373911260\",\"text\":\"Imagine this person with various trending hairstyles\",\"longPrompt\":\"Create an a row of three images showing the subject with new trendy hairstyles inspired by trends on Instagram. The hairstyles should be chosen to match the person's personality and accentuate their features. Each image should be a portrait crop showing the person posed in a way to show off their hair on a bright solid color background with professional commercial lighting.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null}]}}\n"])</script><script nonce="">$RC("B:19","S:19")</script><next-route-announcer style="position: absolute;" data-aria-hidden="true" aria-hidden="true"><template shadowrootmode="open"><div aria-live="assertive" id="__next-route-announcer__" role="alert" style="position: absolute; border: 0px; height: 1px; margin: -1px; padding: 0px; width: 1px; clip: rect(0px, 0px, 0px, 0px); overflow: hidden; white-space: nowrap; overflow-wrap: normal;"></div></template></next-route-announcer><div data-state="open" class="data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 fixed inset-0 z-50 bg-transparent" style="pointer-events: auto;" data-aria-hidden="true" aria-hidden="true"></div><div r