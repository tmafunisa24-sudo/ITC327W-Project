B:1","S:1")</script><script nonce="">self.__next_f.push([1,"87:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1260708592793455\",\"text\":\"Describe what's happening in an image\",\"longPrompt\":\"I'll share an image — tell me what you see and what's going on in it.\",\"type\":\"learn\",\"attachment_type\":\"CAMERA_MEDIA\",\"category\":\"MULTIMODAL\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1433117561847204\",\"text\":\"Debug my code\",\"longPrompt\":\"My code isn't working and I can't figure out why. I'll share it — help me find the bug and explain what went wrong.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"TEST\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"909839255192169\",\"text\":\"Highlight insights from a report\",\"longPrompt\":\"I have a report with a lot of data in it and want to understand what it's really saying. I'll share it — help me pull out the most important takeaways.\",\"type\":\"learn\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":\"IDEAS\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"2024165345190838\",\"text\":\"Explain a diagram\",\"longPrompt\":\"I have a diagram I'm trying to make sense of. I'll share it — can you walk me through what it's showing and how it all connects?\",\"type\":\"learn\",\"attachment_type\":\"CAMERA_MEDIA\",\"category\":\"HOMEWORK_HELP\",\"responseDisplayMode\":\"full_prompt\"}]}}\n"])</script><script nonce="">$RC("B:1c","S:1c")</script><script nonce="">self.__next_f.push([1,"83:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1433117561847204\",\"text\":\"Debug my code\",\"longPrompt\":\"My code isn't working and I can't figure out why. I'll share it — help me find the bug and explain what went wrong.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"TEST\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1323004776550630\",\"text\":\"Help me discover trending workouts\",\"longPrompt\":\"What are the latest workout trends on Instagram\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"NEWS\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"2954607668082530\",\"text\":\"Suggest a meal based on what's in my fridge\",\"longPrompt\":\"Look at everything in my fridge. Label what's ripe and ready to eat, what's got a few days left, and what I should toss. Suggest a meal using what's at its peak.\",\"type\":\"learn\",\"attachment_type\":\"CAMERA_MEDIA\",\"category\":\"IDEAS\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"799055749157446\",\"text\":\"Give me a skincare routine\",\"longPrompt\":\"Work with me to figure out the perfect, personalized skincare routine that will leave me glowing.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"HEALTH_AND_WELLNESS\",\"responseDisplayMode\":\"default\"}]}}\n"])</script><script nonce="">$RC("B:18","S:18")</script><script nonce="">self.__next_f.push([1,"86:{\"data\":{\"conversationStartersByType\":[{\"id\":\"910702038433183\",\"text\":\"Role play an interview\",\"longPrompt\":\"I have an interview coming up and want to practice. Act like a real hiring manager and put me through some tough questions.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"SUGGEST\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"2411666645966756\",\"text\":\"Recommend rooftop restaurants near me\",\"longPrompt\":\"Recommend rooftop restaurants near me\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"LIFESTYLE\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1243809197876134\",\"text\":\"Review my essay\",\"longPrompt\":\"I just finished a draft of an essay and want honest feedback on it.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"WRITE\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1602379481031442\",\"text\":\"Help me build a website\",\"longPrompt\":\"I want to build a website but don't know where to start. Help me figure out the best way to get going.\",\"type\":\"learn\",\"attachment_typ