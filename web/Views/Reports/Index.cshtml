@model ServiceHub_IT.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="reports-page">
<header class="service-page-hero">
    <div>
        <span class="service-page-kicker">ANALYTICS</span>
        <h1>Reports</h1>
        <p class="page-note">Generate reports from available ServiceHub records.</p>
    </div>
</header>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="content-panel card-custom reports-form-card">
            <span class="service-page-kicker">REPORT GENERATOR</span>
            <h2 class="h4 mb-3">Create Report</h2>
            <form asp-action="Generate" method="post">
                <div class="mb-3">
                    <label asp-for="ReportType" class="form-label">Report Type</label>
                    <select asp-for="ReportType" class="form-select">
                        <option>Tickets</option>
                        <option>Users</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Generate Report</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="content-panel card-custom reports-catalog-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <span class="service-page-kicker">REPORT CATALOG</span>
                    <h2 class="h4 mb-1">Available Reports</h2>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">Tickets</li>
                <li class="list-group-item">Users</li>
            </ul>
        </div>
    </div>
</div>
</div>
