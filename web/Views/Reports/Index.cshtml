@model ServiceHub_IT.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1>Reports</h1>
        <p class="page-note">Generate operational reports for assets, staffing, tickets, maintenance, and technician performance.</p>
    </div>
    <div class="topbar-pill">Reports</div>
</div>

<div class="hero-panel mb-4">
    <div>
        <h2 class="h3 mb-2">Reports workspace</h2>
        <p class="mb-0">Create and preview business reports with an interface that matches the dashboard experience.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <span class="topbar-pill">Quick access</span>
        <span class="topbar-pill">Export ready</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="content-panel card card-body shadow-sm border-0 bg-white rounded-4">
            <h5 class="mb-3">Create report</h5>
            <form asp-action="Generate" method="post">
                <div class="mb-3">
                    <label asp-for="ReportType" class="form-label">Report Type</label>
                    <select asp-for="ReportType" class="form-select">
                        <option>Assets</option>
                        <option>Clients</option>
                        <option>Tickets</option>
                        <option>Departments</option>
                        <option>Maintenance</option>
                        <option>Technician Performance</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Generate Report</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="content-panel card card-body shadow-sm border-0 bg-white rounded-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-1">Available Reports</h5>
                    <p class="page-note mb-0">Choose from prebuilt report categories for faster data delivery.</p>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">Assets</li>
                <li class="list-group-item">Clients</li>
                <li class="list-group-item">Tickets</li>
                <li class="list-group-item">Departments</li>
                <li class="list-group-item">Maintenance</li>
                <li class="list-group-item">Technician Performance</li>
            </ul>
        </div>
    </div>
</div>
