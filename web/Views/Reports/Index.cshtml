@model ServiceHub_IT.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1>Reports</h1>
        <p class="page-note">Review ticket activity, assets, maintenance, and measured technician workload.</p>
    </div>
    <div class="topbar-pill">Admin and technician access</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-4">
    <div class="col-xl-5">
        <div class="content-panel card card-body shadow-sm border-0 bg-white rounded-4">
            <h2 class="h5 mb-3">Create a report</h2>
            <p class="page-note">Filters are applied by Supabase before records are returned. The date range uses ticket creation, asset purchase, or maintenance date as appropriate. Technician ticket reports are limited to the signed-in technician's assignments.</p>
            <form asp-action="Generate" method="post">
                <div class="mb-3">
                    <label asp-for="ReportType" class="form-label">Report type</label>
                    <select asp-for="ReportType" class="form-select">
                        <option value="Tickets">Tickets</option>
                        <option value="Assets">Assets</option>
                        <option value="Maintenance">Maintenance</option>
                        <option value="Technician Performance">Technician performance</option>
                    </select>
                    <span asp-validation-for="ReportType" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">Start date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">End date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status <span class="text-muted">(optional)</span></label>
                    <input asp-for="Status" class="form-control" maxlength="64" placeholder="For example: Open" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label">Ticket priority <span class="text-muted">(ticket reports only)</span></label>
                        <input asp-for="Priority" class="form-control" maxlength="64" placeholder="For example: High" />
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DeviceType" class="form-label">Device type <span class="text-muted">(ticket reports only)</span></label>
                        <input asp-for="DeviceType" class="form-control" maxlength="64" placeholder="For example: Laptop" />
                        <span asp-validation-for="DeviceType" class="text-danger"></span>
                    </div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="mb-3">
                        <label asp-for="TechnicianId" class="form-label">Technician profile ID <span class="text-muted">(tickets only, optional)</span></label>
                        <input asp-for="TechnicianId" class="form-control" inputmode="text" placeholder="Technician UUID" />
                        <span asp-validation-for="TechnicianId" class="text-danger"></span>
                    </div>
                }
                <button type="submit" class="btn btn-primary">Generate report</button>
            </form>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="content-panel card card-body shadow-sm border-0 bg-white rounded-4">
            <h2 class="h5 mb-3">Data included</h2>
            <ul class="list-group list-group-flush">
                <li class="list-group-item px-0"><strong>Tickets:</strong> status, priority, device, category, assigned technician, and created/closed dates.</li>
                <li class="list-group-item px-0"><strong>Assets:</strong> registered asset, category, status, purchase date, and warranty expiry.</li>
                <li class="list-group-item px-0"><strong>Maintenance:</strong> status, asset and technician IDs, service dates, and recorded cost.</li>
                <li class="list-group-item px-0"><strong>Technician performance:</strong> assigned, resolved/closed, outstanding tickets, and average duration only when valid creation and closure timestamps exist.</li>
            </ul>
            <p class="page-note mt-3 mb-0">Reports query selected fields and apply date/record filters at the data source. Results are capped at 5,000 records and clearly marked if the cap is reached.</p>
        </div>
    </div>
</div>
