@model List<Dictionary<string, object?>>
@{
    ViewData["Title"] = "Printable Report";
    var reportType = ViewBag.ReportType as string ?? "Report";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@reportType Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            color: #0f172a;
            background: #ffffff;
        }
        .report-container {
            background: #ffffff;
            color: #0f172a;
        }
        .table th,
        .table td {
            color: #0f172a;
            border-color: #dbe5f0;
        }
        .report-title {
            color: #0f172a;
        }
        .report-summary {
            color: #475569;
        }
        @@media print {
            .print-toolbar { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="container py-4 report-container">
        <div class="d-flex justify-content-between align-items-center mb-3 print-toolbar">
            <h2 class="mb-0 report-title">@reportType Report</h2>
            <button type="button" class="btn btn-primary" onclick="window.print()">Print / Save as PDF</button>
        </div>
        <h2 class="mb-3 report-title d-none d-print-block">@reportType Report</h2>
        <p class="report-summary">Printable report generated for the selected date range.</p>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        @if (Model.Any())
                        {
                            foreach (var key in Model.First().Keys)
                            {
                                <th>@key</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            @foreach (var key in row.Keys)
                            {
                                <td>@row[key]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
