@model ServiceHub_IT.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "Printable Report";
    var firstRow = Model.Rows.FirstOrDefault();
    IEnumerable<string> columns = firstRow is null ? Enumerable.Empty<string>() : firstRow.Values.Keys;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.ReportType Report</title>
    <style>
        body { color: #172033; font: 14px/1.45 Arial, sans-serif; margin: 2rem; }
        h1 { margin-bottom: .25rem; }
        .muted { color: #526078; }
        .filters, .summary { margin: 1rem 0; }
        .filters span, .summary span { display: inline-block; margin: 0 .8rem .4rem 0; }
        table { border-collapse: collapse; margin-top: 1rem; width: 100%; }
        th, td { border: 1px solid #cbd5e1; padding: .45rem; text-align: left; overflow-wrap: anywhere; }
        th { background: #edf2f7; }
        .actions { margin-bottom: 1rem; }
        @@media print {
            body { margin: 0; }
            .actions { display: none; }
            tr { break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="actions">
        <button type="button" onclick="window.print()">Print / Save as PDF</button>
        <a href="@Url.Action("Index", "Reports")">Back to reports</a>
    </div>
    <h1>@Model.ReportType Report</h1>
    <p class="muted">Generated @Model.GeneratedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p role="alert">@Model.ErrorMessage</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Notice))
        {
            <p class="muted">@Model.Notice</p>
        }
        <div class="filters">
            <strong>Filters:</strong>
            @foreach (var filter in Model.GetAppliedFilters())
            {
                <span>@filter.Key: @filter.Value</span>
            }
        </div>
        <div class="summary">
            @foreach (var item in Model.Summary)
            {
                <span><strong>@item.Label:</strong> @item.Value</span>
            }
        </div>
        @if (Model.Rows.Count == 0)
        {
            <p>No records matched the selected filters.</p>
        }
        else
        {
            <p class="muted">Showing @Model.RecordsReturned.ToString("N0") of @Model.TotalRecords.ToString("N0") matching records.</p>
            <table>
                <thead>
                    <tr>
                        @foreach (var column in columns)
                        {
                            <th scope="col">@column</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var column in columns)
                            {
                                <td>@row.Values.GetValueOrDefault(column)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</body>
</html>
