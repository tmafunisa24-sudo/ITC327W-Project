@model ServiceHub_IT.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "Report Preview";
    var firstRow = Model.Rows.FirstOrDefault();
    IEnumerable<string> columns = firstRow is null ? Enumerable.Empty<string>() : firstRow.Values.Keys;
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1>@Model.ReportType Report</h1>
        <p class="page-note">Preview the filtered data and export the same results for review.</p>
    </div>
    <div class="topbar-pill">Generated @Model.GeneratedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-info" role="status">@Model.Notice</div>
    }

    <div class="row g-3 mb-4">
        @foreach (var item in Model.Summary)
        {
            <div class="col-6 col-lg-3">
                <div class="content-panel h-100">
                    <div class="page-note mb-1">@item.Label</div>
                    <strong>@item.Value</strong>
                </div>
            </div>
        }
    </div>

    <div class="content-panel mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h2 class="h5 mb-2">Applied filters</h2>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var filter in Model.GetAppliedFilters())
                    {
                        <span class="badge text-bg-light">@filter.Key: @filter.Value</span>
                    }
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Export" asp-route-type="csv" asp-route-ReportType="@Model.ReportType" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-Status="@Model.Status" asp-route-Priority="@Model.Priority" asp-route-DeviceType="@Model.DeviceType" asp-route-TechnicianId="@Model.TechnicianId" class="btn btn-outline-primary">Export CSV</a>
                <a asp-action="Export" asp-route-type="excel" asp-route-ReportType="@Model.ReportType" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-Status="@Model.Status" asp-route-Priority="@Model.Priority" asp-route-DeviceType="@Model.DeviceType" asp-route-TechnicianId="@Model.TechnicianId" class="btn btn-outline-success">Export Excel</a>
                <a asp-action="Print" asp-route-ReportType="@Model.ReportType" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-Status="@Model.Status" asp-route-Priority="@Model.Priority" asp-route-DeviceType="@Model.DeviceType" asp-route-TechnicianId="@Model.TechnicianId" class="btn btn-outline-secondary">Print / Save as PDF</a>
            </div>
        </div>

        @if (Model.Rows.Count == 0)
        {
            <div class="alert alert-light mb-0" role="status">No rows to display. You can adjust the filters and generate another report.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <caption class="caption-top">Showing @Model.RecordsReturned.ToString("N0") of @Model.TotalRecords.ToString("N0") matching records.</caption>
                    <thead>
                        <tr>
                            @foreach (var column in columns)
                            {
                                <th scope="col">@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var column in columns)
                                {
                                    <td>@row.Values.GetValueOrDefault(column)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<a asp-action="Index" class="btn btn-link">Back to report filters</a>
