<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563EB" />
    <title>ServiceHub IT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
            var role = User?.IsInRole("Admin") == true ? "Admin" : User?.IsInRole("Technician") == true ? "Technician" : "Client";
        }

        <aside class="sidebar">
            <div class="sidebar-logo sidebar-brand-lockup"><img class="sidebar-brand-mark" src="~/images/click-laptop-phone-logo.png.jpg" asp-append-version="true" alt="ServiceHub IT logo" /><span class="sidebar-brand-copy"><strong>ServiceHub IT</strong><small>ITSM &amp; Asset Platform</small></span></div>

            <ul class="nav nav-pills flex-column gap-1 mt-2">
                @if (role == "Admin")
                {
                    <li class="nav-item"><a class="nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i>Tickets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Users</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Admin" && currentAction == "Technicians" ? "active" : "")" asp-controller="Admin" asp-action="Technicians"><i class="bi bi-person-gear me-2"></i>Technicians</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Reports</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" && currentAction == "Profile" ? "active" : "")" asp-controller="Home" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>Profile</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2"></i>Privacy</a></li>
                }
                else if (role == "Technician")
                {
                    <li class="nav-item"><a class="nav-link @(currentController == "Technician" ? "active" : "")" asp-controller="Technician" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i>Tickets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" && currentAction == "Profile" ? "active" : "")" asp-controller="Home" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>Profile</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2"></i>Privacy</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @(currentController == "Employee" && currentAction == "Index" ? "active" : "")" asp-controller="Employee" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i>Tickets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" && currentAction == "Profile" ? "active" : "")" asp-controller="Home" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>Profile</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2"></i>Privacy</a></li>
                }
            </ul>
            <div class="sidebar-footer">
                <span class="sidebar-footer-dot"></span>
                <span><small>Service workspace</small><strong>Ticket operations</strong></span>
                <i class="bi bi-shield-check"></i>
            </div>
        </aside>

        <div class="content-panel">
            <nav class="topbar">
                <div class="topbar-left topbar-heading">
                    <span class="badge-premium">Premium Ops</span>
                    <h1 class="topbar-title">Service Operations Center</h1>
                </div>
                <div class="topbar-right topbar-actions position-relative">
                    <span class="service-live-badge"><i></i>Live</span>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown notification-dropdown">
                            <button class="btn btn-light border rounded-pill notification-toggle" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bell-fill"></i>
                                <span class="notification-count badge bg-danger rounded-pill" id="notificationCount">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationDropdown">
                                <div class="notification-menu-header d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                    <div>
                                        <strong>Notifications</strong>
                                        <div class="text-muted small" id="notificationHeaderSubtitle">Latest updates</div>
                                    </div>
                                    <button class="btn btn-sm btn-link text-decoration-none" id="markAllNotificationsRead">Mark all read</button>
                                </div>
                                <div class="px-3 py-2">
                                    @Html.AntiForgeryToken()
                                </div>
                                <div class="notification-items" id="notificationItems">
                                    <div class="dropdown-item text-center text-muted py-4">Loading notifications...</div>
                                </div>
                                <div class="notification-menu-barter border-top px-3 py-2">
                                    <a class="d-flex justify-content-between align-items-center text-decoration-none" asp-controller="Notifications" asp-action="Index">
                                        <span>View all notifications</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    <span class="topbar-pill profile-pill role-badge badge-role"><i class="bi bi-shield-check"></i>@role</span>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm topbar-btn">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm topbar-btn" asp-controller="Auth" asp-action="Login">Sign In</a>
                    }
                    <span class="topbar-profile-icon" title="Profile" aria-hidden="true"><i class="bi bi-person-circle"></i></span>
                </div>
            </nav>

            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>
    <div id="toastMessages" data-success="@(TempData["Success"] ?? string.Empty)" data-error="@(TempData["Error"] ?? string.Empty)"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        // Only attach confirmation handlers to forms explicitly opting in via data-confirm="true"
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('form[data-confirm="true"]').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    const confirmed = window.confirm('Are you sure you want to continue?');
                    if (!confirmed) {
                        event.preventDefault();
                    }
                });
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
