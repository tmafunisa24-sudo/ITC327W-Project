@model ServiceHub_IT.Models.SignUpViewModel
@* Create account page. Posts to AuthController.SignUp; new accounts need administrator approval before sign in. *@
@{
    ViewData["Title"] = "Create account";
    // Uses the login layout (no main navigation bar).
    Layout = "_LoginLayout";
}

@* Styles for the show/hide password button. *@
<style>
    /* Show/hide password button, positioned inside the password field. */
    .password-input-wrap {
        position: relative;
    }

    .password-input-wrap .form-control {
        padding-right: 2.9rem;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 0.65rem;
        transform: translateY(-50%);
        z-index: 5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid rgba(108, 117, 125, 0.15);
        background: rgba(255, 255, 255, 0.8);
        color: #475569;
        border-radius: 0.5rem;
        padding: 0;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    }

    .password-toggle:hover,
    .password-toggle:focus-visible {
        color: #0d6efd;
        background: rgba(13, 110, 253, 0.08);
        outline: none;
    }

    .password-toggle i {
        font-size: 1.1rem;
        line-height: 1;
    }
</style>

<div class="card p-4 fade-in">
    <h3 class="fw-semibold mb-3">Create account</h3>
    <p class="text-muted">Sign up for ServiceHub IT and then sign in to continue.</p>

    @* The form tag helper adds the anti-forgery token automatically. *@
    <form asp-action="SignUp" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            @* Email address used as the login name. *@
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="name@company.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            @* Password field (8 to 100 characters) with show/hide button. *@
            <label asp-for="Password" class="form-label"></label>
            <div class="password-input-wrap">
                <input asp-for="Password" class="form-control" placeholder="Create password" />
                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            @* Confirmation field; must match the password (checked by [Compare] in the view model). *@
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <div class="password-input-wrap">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" />
                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button class="btn btn-primary w-100">Create account</button>
    </form>

    <div class="mt-3 text-center">
        @* Link for users who already have an account. *@
        <span>Already have an account?</span>
        <a asp-action="Login" class="text-decoration-none">Sign in</a>
    </div>
</div>

@* Client-side behaviour: password show/hide. *@
<script>
    (() => {
        // Show/hide password: for each eye button, find the password input in the same wrapper.
        document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
            const input = toggle.closest('.password-input-wrap')?.querySelector('input');
            if (!input) {
                return;
            }

            const icon = toggle.querySelector('i');
            // Switches the input between password and text, and updates the icon and accessibility labels.
            const setVisible = (isVisible) => {
                input.type = isVisible ? 'text' : 'password';
                toggle.setAttribute('aria-label', isVisible ? 'Hide password' : 'Show password');
                toggle.setAttribute('aria-pressed', String(isVisible));

                if (icon) {
                    icon.classList.toggle('bi-eye', !isVisible);
                    icon.classList.toggle('bi-eye-slash', isVisible);
                }
            };

            // On click, flip visibility, then return focus to the field with the cursor at the end.
            toggle.addEventListener('click', (event) => {
                event.preventDefault();
                const nextVisible = input.type !== 'text';
                setVisible(nextVisible);
                input.focus();
                const end = input.value.length;
                input.setSelectionRange(end, end);
            });
        });
    })();
</script>
