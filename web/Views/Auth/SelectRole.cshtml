@{
    ViewData["Title"] = "Choose your role";
    Layout = "_LoginLayout";
}

<div class="card p-4 fade-in">
    <h3 class="fw-semibold mb-3">How will you use ServiceHub IT?</h3>
    <p class="text-muted">This choice is permanent. Choose carefully.</p>

    <form asp-action="SelectRole" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <button type="submit" name="roleChoice" value="client"
                        class="btn btn-outline-primary w-100 py-4">
                    <strong>I'm a Client</strong>
                    <div class="small text-muted mt-1">Report issues and track my tickets.</div>
                </button>
            </div>
            <div class="col-md-6">
                <button type="submit" name="roleChoice" value="technician"
                        class="btn btn-outline-secondary w-100 py-4">
                    <strong>I'm a Technician</strong>
                    <div class="small text-muted mt-1">Service tickets. Requires admin approval.</div>
                </button>
            </div>
        </div>
    </form>
</div>