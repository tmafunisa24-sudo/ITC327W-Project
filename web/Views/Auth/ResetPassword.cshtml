@model ServiceHub_IT.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LoginLayout";
}

<style>
    .password-input-wrap {
        position: relative;
    }

    .password-input-wrap .form-control {
        padding-right: 2.9rem;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 0.65rem;
        transform: translateY(-50%);
        z-index: 5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid rgba(108, 117, 125, 0.15);
        background: rgba(255, 255, 255, 0.8);
        color: #475569;
        border-radius: 0.5rem;
        padding: 0;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    }

    .password-toggle:hover,
    .password-toggle:focus-visible {
        color: #0d6efd;
        background: rgba(13, 110, 253, 0.08);
        outline: none;
    }

    .password-toggle i {
        font-size: 1.1rem;
        line-height: 1;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4 p-4">
            <h3 class="fw-semibold mb-3">Reset password</h3>
            <p id="reset-status" class="text-muted">Validating your reset link…</p>

            <form id="reset-form" asp-action="ResetPassword" method="post" class="d-none">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="Token" type="hidden" id="recovery-token" />
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="password-input-wrap">
                        <input asp-for="NewPassword" class="form-control" />
                        <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="password-input-wrap">
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button class="btn btn-primary w-100">Update password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const params = new URLSearchParams(window.location.hash.substring(1));
            const token = params.get('access_token');
            const type = params.get('type');
            const status = document.getElementById('reset-status');

            if (!token || (type && type !== 'recovery')) {
                if (status) status.textContent = 'This reset link is invalid or has expired. Please request a new one.';
                return;
            }

            const tokenInput = document.getElementById('recovery-token');
            if (tokenInput) tokenInput.value = token;
            if (status) status.classList.add('d-none');
            const form = document.getElementById('reset-form');
            if (form) form.classList.remove('d-none');
        })();
    </script>
}
