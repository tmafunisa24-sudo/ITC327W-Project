@model ServiceHub_IT.Models.ForgotPasswordViewModel
@* Forgot password page: the user enters their email so a reset link can be sent. *@
@{
    ViewData["Title"] = "Forgot Password";
    // Uses the login layout (no main navigation bar).
    Layout = "_LoginLayout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4 p-4">
            <h3 class="fw-semibold mb-3">Forgot password?</h3>
            <p class="text-muted">Enter your email to receive a reset link.</p>

            @* The form tag helper posts to the ForgotPassword action and adds the anti-forgery token automatically. *@
            <form asp-action="ForgotPassword" method="post">
                @* Shows errors that are not tied to one specific field. *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    @* Bound to ForgotPasswordViewModel.Email; validation errors appear in the span below the input. *@
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button class="btn btn-primary w-100">Send reset link</button>
            </form>

            <div class="mt-3 text-center">
                @* Link back to the sign in page. *@
                <a asp-action="Login" class="text-decoration-none">Back to sign in</a>
            </div>
        </div>
    </div>
</div>
