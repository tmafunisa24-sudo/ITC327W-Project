@model IReadOnlyList<ServiceHub_IT.Models.Ticket>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tickets";
    var isAdmin = User?.IsInRole("Admin") == true;
    var isTechnician = User?.IsInRole("Technician") == true;
    var technicians = ViewBag.Technicians as IEnumerable<ServiceHub_IT.Models.Profile> ?? Enumerable.Empty<ServiceHub_IT.Models.Profile>();
    string AssignedTechnicianName(ServiceHub_IT.Models.Ticket ticket)
    {
        if (ticket.technician_id.HasValue)
        {
            var profile = technicians.FirstOrDefault(technician => technician.Id == ticket.technician_id.Value);
            return profile is null ? ticket.technician_id.Value.ToString() : (!string.IsNullOrWhiteSpace(profile.FullName) ? profile.FullName : profile.Email);
        }

        return string.IsNullOrWhiteSpace(ticket.assigned_technician) ? "Unassigned" : ticket.assigned_technician;
    }
    string TicketNumber(ServiceHub_IT.Models.Ticket ticket)
    {
        if (!string.IsNullOrWhiteSpace(ticket.ticket_number))
        {
            return ticket.ticket_number;
        }

        if (string.IsNullOrWhiteSpace(ticket.id))
        {
            return "Not assigned";
        }

        if (ticket.id.StartsWith("TKT-", StringComparison.OrdinalIgnoreCase))
        {
            return ticket.id;
        }

        return $"TKT-{ticket.id[..Math.Min(ticket.id.Length, 8)].ToUpperInvariant()}";
    }
    var totalTickets = Model.Count();
    var activeTickets = Model.Count(ticket => !string.Equals(ticket.status, "Resolved", StringComparison.OrdinalIgnoreCase) && !string.Equals(ticket.status, "Closed", StringComparison.OrdinalIgnoreCase));
    var resolvedTickets = Model.Count(ticket => string.Equals(ticket.status, "Resolved", StringComparison.OrdinalIgnoreCase) || string.Equals(ticket.status, "Closed", StringComparison.OrdinalIgnoreCase));
}

@section Styles {
    <link rel="stylesheet" href="~/css/tickets.css" asp-append-version="true" />
}

<div class="ticket-page service-records-page">
    <header class="hero-header service-page-hero">
        <div class="service-page-heading">
            <span class="service-page-kicker">SERVICE RECORDS</span>
            <h1>Tickets</h1>
            <p>Manage and track all support requests.</p>
        </div>
        @if (!isAdmin && !isTechnician)
        {
            <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary btn-create-ticket"><i class="bi bi-plus-lg me-2"></i>Create Ticket</a>
        }
    </header>

    <div class="ticket-alerts">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        else if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
    </div>

    <div class="service-metric-grid">
        <article class="card-custom service-metric-card"><span class="card-title">TOTAL TICKETS</span><strong class="card-value">@totalTickets</strong><span class="service-metric-icon"><i class="bi bi-list-task"></i></span></article>
        <article class="card-custom service-metric-card"><span class="card-title">OPEN TICKETS</span><strong class="card-value">@activeTickets</strong><span class="service-metric-icon service-icon-warning"><i class="bi bi-lightning-charge"></i></span></article>
        <article class="card-custom service-metric-card"><span class="card-title">RESOLVED TICKETS</span><strong class="card-value">@resolvedTickets</strong><span class="service-metric-icon service-icon-success"><i class="bi bi-check2-circle"></i></span></article>
    </div>

    <div class="ticket-content-container">
        @if (Model.Any())
        {
            <div class="card-custom ticket-table-card">
            <div class="row g-3 align-items-end mb-3 ticket-filter-bar">
                <div class="col-sm-6 col-lg-3">
                    <label for="ticketStatusFilter" class="form-label card-title">Status</label>
                    <select id="ticketStatusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="open">Open</option>
                        <option value="assigned">Assigned</option>
                        <option value="in progress">In Progress</option>
                        <option value="resolved">Resolved</option>
                        <option value="closed">Closed</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="ticketCreatedDateFilter" class="form-label card-title">Date Created</label>
                    <input id="ticketCreatedDateFilter" type="date" class="form-control" />
                </div>
            </div>
            <div class="ticket-table-wrapper">
                <table class="ticket-table">
                    <thead>
                        <tr>
                            <th class="card-title">Ticket ID</th>
                            <th class="card-title">Ticket Number</th>
                            <th class="card-title">Device</th>
                            <th class="card-title">Problem</th>
                            @if (isAdmin)
                            {
                                <th class="card-title">Requester</th>
                            }
                            <th class="card-title">Priority</th>
                            <th class="card-title">Status</th>
                            <th class="card-title">Assigned Technician</th>
                            <th class="card-title">Due Date</th>
                            <th class="card-title">Created</th>
                            <th class="card-title">Updated</th>
                            <th class="card-title">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                                var priorityText = string.IsNullOrWhiteSpace(ticket.priority) ? "Medium" : ticket.priority.Trim();
                                var statusText = string.IsNullOrWhiteSpace(ticket.status) ? "Open" : ticket.status.Trim();
                                var statusKey = statusText.ToLowerInvariant();
                                var statusClass = statusKey == "open" ? "pill-warning"
                                    : statusKey == "assigned" || statusKey == "in progress" ? "pill-blue"
                                    : statusKey == "resolved" || statusKey == "closed" ? "pill-success"
                                    : "pill-neutral";
                            <tr data-status="@statusKey" data-created-date="@(ticket.created_at?.ToString("yyyy-MM-dd") ?? string.Empty)">
                                <td><span class="ticket-id">@(string.IsNullOrWhiteSpace(ticket.id) ? "Not available" : ticket.id)</span></td>
                                <td><span class="ticket-id">@TicketNumber(ticket)</span></td>
                                <td>@(ticket.device_type ?? "Not specified")</td>
                                <td><div class="ticket-title">@(ticket.problem_type ?? ticket.title)</div></td>
                                @if (isAdmin)
                                {
                                    <td>
                                        <div class="ticket-requester">
                                            @if (string.IsNullOrWhiteSpace(ticket.requester))
                                            {
                                                <span class="requester-muted">Not provided</span>
                                            }
                                            else
                                            {
                                                @ticket.requester
                                            }
                                        </div>
                                    </td>
                                }
                                <td>
                                    <span class="priority-badge @(string.Equals(priorityText, "High", StringComparison.OrdinalIgnoreCase) ? "priority-high" : string.Equals(priorityText, "Critical", StringComparison.OrdinalIgnoreCase) ? "priority-critical" : string.Equals(priorityText, "Low", StringComparison.OrdinalIgnoreCase) ? "priority-low" : "priority-medium")">
                                        @priorityText
                                    </span>
                                </td>
                                <td>
                                    <span class="prototype-pill @statusClass">@statusText</span>
                                </td>
                                <td>
                                    @if (!ticket.technician_id.HasValue && string.IsNullOrWhiteSpace(ticket.assigned_technician))
                                    {
                                        <span class="ticket-assigned tech-muted">Unassigned</span>
                                    }
                                    else
                                    {
                                        <span class="ticket-assigned tech-name">@AssignedTechnicianName(ticket)</span>
                                    }
                                </td>
                                <td><span class="ticket-date @(ticket.due_date is null ? "date-muted" : string.Empty)">@(ticket.due_date is null ? "Not set" : ticket.due_date.Value.ToString("dd MMM yyyy"))</span></td>
                                <td><span class="ticket-date">@(ticket.created_at is null ? "—" : ticket.created_at.Value.ToString("dd MMM yyyy"))</span></td>
                                <td><span class="ticket-date">@(ticket.updated_at is null ? "—" : ticket.updated_at.Value.ToString("dd MMM yyyy"))</span></td>
                                <td>
                                    <div class="actions">
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.id" class="btn btn-view btn-sm"><i class="bi bi-eye me-1"></i>View</a>
                                        @if (isAdmin)
                                        {
                                            <div class="action-row">
                                                <form asp-controller="Tickets" asp-action="UpdateStatus" asp-route-id="@ticket.id" method="post" class="action-form">
                                                    @Html.AntiForgeryToken()
                                                    <select name="Status" class="ticket-select">
                                                        <option value="Open" selected="@(string.Equals(ticket.status, "Open", StringComparison.OrdinalIgnoreCase))">Open</option>
                                                        <option value="Assigned" selected="@(string.Equals(ticket.status, "Assigned", StringComparison.OrdinalIgnoreCase))">Assigned</option>
                                                        <option value="In Progress" selected="@(string.Equals(ticket.status, "In Progress", StringComparison.OrdinalIgnoreCase))">In Progress</option>
                                                        <option value="Resolved" selected="@(string.Equals(ticket.status, "Resolved", StringComparison.OrdinalIgnoreCase))">Resolved</option>
                                                        <option value="Closed" selected="@(string.Equals(ticket.status, "Closed", StringComparison.OrdinalIgnoreCase))">Closed</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-status btn-sm">Change</button>
                                                </form>
                                            </div>
                                            <div class="action-row">
                                                <form asp-controller="Tickets" asp-action="UpdateDueDate" asp-route-id="@ticket.id" method="post" class="action-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnToIndex" value="true" />
                                                    <input type="date" name="dueDate" class="ticket-date-input" value="@(ticket.due_date?.ToString("yyyy-MM-dd"))" aria-label="Due date" />
                                                    <button type="submit" class="btn btn-status btn-sm">Save Date</button>
                                                </form>
                                            </div>
                                            <form asp-controller="Tickets" asp-action="Delete" asp-route-id="@ticket.id" method="post" data-confirm="true" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-delete btn-sm">Delete</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p id="ticketFilterEmpty" class="text-muted text-center py-4 mb-0" hidden>No tickets match these filters.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h3>No tickets found</h3>
                <p>There are currently no support tickets to display.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const statusFilter = document.getElementById('ticketStatusFilter');
            const dateFilter = document.getElementById('ticketCreatedDateFilter');
            const rows = Array.from(document.querySelectorAll('.ticket-table tbody tr[data-status]'));
            const emptyMessage = document.getElementById('ticketFilterEmpty');

            const applyFilters = () => {
                const status = statusFilter?.value ?? '';
                const createdDate = dateFilter?.value ?? '';
                let visibleCount = 0;

                rows.forEach((row) => {
                    const matchesStatus = !status || row.dataset.status === status;
                    const matchesDate = !createdDate || row.dataset.createdDate === createdDate;
                    const isVisible = matchesStatus && matchesDate;
                    row.style.display = isVisible ? '' : 'none';
                    if (isVisible) visibleCount += 1;
                });

                if (emptyMessage) emptyMessage.hidden = visibleCount !== 0;
            };

            statusFilter?.addEventListener('change', applyFilters);
            dateFilter?.addEventListener('change', applyFilters);
        })();
    </script>
}
