@model ServiceHub_IT.Models.Maintenance
@{
    ViewData["Title"] = "Delete Maintenance";
    Layout = "_Layout";
}

<div class="container-fluid px-0">
    <div class="page-section mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h4 fw-semibold mb-1">Confirm Delete</h2>
                <p class="text-muted mb-0">This action will remove the maintenance record from the system.</p>
            </div>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    <div class="card p-4">
        <div class="mb-4">
            <p class="lead">Are you sure you want to delete maintenance for <strong>@ViewBag.AssetName</strong> assigned to <strong>@ViewBag.TechnicianName</strong>?</p>
            <p class="text-muted">This cannot be undone.</p>
        </div>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.id" method="post" data-confirm="true">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
