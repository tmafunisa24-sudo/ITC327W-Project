@model ServiceHub_IT.Models.Maintenance
@{
    ViewData["Title"] = "Maintenance Details";
    Layout = "_Layout";
}

<div class="container-fluid px-0">
    <div class="page-section mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h4 fw-semibold mb-1">Maintenance Details</h2>
                <p class="text-muted mb-0">View the full record for this maintenance task.</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-secondary me-2">Back to List</a>
                <a asp-action="Edit" asp-route-id="@Model.id" class="btn btn-primary">Edit</a>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Asset</dt>
            <dd class="col-sm-9">@ViewBag.AssetName</dd>

            <dt class="col-sm-3">Technician</dt>
            <dd class="col-sm-9">@ViewBag.TechnicianName</dd>

            <dt class="col-sm-3">Problem</dt>
            <dd class="col-sm-9">@Model.problem</dd>

            <dt class="col-sm-3">Solution</dt>
            <dd class="col-sm-9">@Model.solution</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.status</dd>

            <dt class="col-sm-3">Maintenance Date</dt>
            <dd class="col-sm-9">@Model.maintenance_date?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Next Service Date</dt>
            <dd class="col-sm-9">@Model.next_service_date?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Cost</dt>
            <dd class="col-sm-9">@Model.maintenance_cost?.ToString("C")</dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.created_at?.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
