@model IEnumerable<ServiceHub_IT.Models.Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
    <div>
        <h1>Departments</h1>
        <p class="page-note">Manage department records and summarize staffing, client counts, and asset coverage with a clean operational view.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">Create Department</a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="content-panel h-100">
            <h5 class="mb-2">Departments Overview</h5>
            <p class="text-muted mb-0">Track organizational structure and resource distribution across each department.</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-panel h-100">
            <h5 class="mb-2">Total Departments</h5>
            <h2 class="fw-bold mb-0">@Model.Count()</h2>
        </div>
    </div>
</div>

<div class="content-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 departments-table">
            <thead>
                <tr>
                    <th>Department Name</th>
                    <th>Number of Clients</th>
                    <th>Number of Assets</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <td>
                            <div class="department-title">
                                <span class="department-name">@department.name</span>
                            </div>
                        </td>
                        <td>@(department.employee_count ?? 0)</td>
                        <td>@(department.asset_count ?? 0)</td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@department.id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@department.id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this department?');">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
