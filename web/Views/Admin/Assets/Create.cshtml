@model ServiceHub_IT.Models.AssetFormViewModel
@{
    ViewData["Title"] = "Create Asset";
    Layout = "_Layout";
}

<div class="card shadow-sm border-0 rounded-4 p-4">
    <h3 class="fw-semibold mb-3">Add Asset</h3>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="AssetTag" class="form-label"></label>
                <input asp-for="AssetTag" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="AssetName" class="form-label"></label>
                <input asp-for="AssetName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="SerialNumber" class="form-label"></label>
                <input asp-for="SerialNumber" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="WarrantyExpiry" class="form-label"></label>
                <input asp-for="WarrantyExpiry" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="Department" class="form-label"></label>
                <input asp-for="Department" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="AssignedEmployee" class="form-label">Assigned Client</label>
                <input asp-for="AssignedEmployee" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Available">Available</option>
                    <option value="Assigned">Assigned</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="ImageFile" class="form-label"></label>
                <input asp-for="ImageFile" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            </div>
            <div class="col-md-6">
                <label asp-for="WarrantyFile" class="form-label"></label>
                <input asp-for="WarrantyFile" class="form-control" type="file" />
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Asset</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
