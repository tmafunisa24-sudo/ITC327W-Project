@model ServiceHub_IT.DTOs.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

<div class="container-fluid admin-users-page">
    <header class="hero-header service-page-hero">
        <div>
            <span class="service-page-kicker">DIRECTORY</span>
            <h1>User Management</h1>
            <p>Approve, assign roles, and manage access.</p>
        </div>
        <div class="users-pending-summary"><i class="bi bi-shield-check"></i>@Model.PendingApprovals pending approvals</div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success mt-4">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger mt-4">@error</div>
    }
    @if (TempData["Error"] is string detailedError)
    {
        <div class="alert alert-danger mt-2">@detailedError</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-3"><div class="card-custom service-metric-card"><span class="card-title">TOTAL USERS</span><strong class="card-value">@Model.TotalUsers</strong></div></div>
        <div class="col-md-3"><div class="card-custom service-metric-card"><span class="card-title">PENDING REGISTRATION</span><strong class="card-value">@Model.PendingRegistrationApprovals</strong></div></div>
        <div class="col-md-3"><div class="card-custom service-metric-card"><span class="card-title">PENDING TECHNICIAN APPROVAL</span><strong class="card-value">@Model.PendingTechnicianApprovals</strong></div></div>
        <div class="col-md-3"><div class="card-custom service-metric-card"><span class="card-title">CLIENTS</span><strong class="card-value">@Model.Employees</strong></div></div>
        <div class="col-md-3"><div class="card-custom service-metric-card"><span class="card-title">TECHNICIANS &amp; ADMINS</span><strong class="card-value">@(Model.Technicians + Model.Administrators)</strong></div></div>
    </div>

    <div class="card-custom users-table-card">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th class="card-title">Email</th>
                        <th class="card-title">Full Name</th>
                        <th class="card-title">Role</th>
                        <th class="card-title">Status</th>
                        <th class="card-title">Created</th>
                        <th class="card-title text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in Model.Profiles)
                    {
                        <tr>
                            <td>@profile.Email</td>
                            <td>@(!string.IsNullOrWhiteSpace(profile.FullName) ? profile.FullName : "—")</td>
                            <td>
                                <span class="badge bg-secondary">@profile.Role</span>
                            </td>
                            <td>
                                <span class="prototype-pill @(string.Equals(profile.Status, "Active", StringComparison.OrdinalIgnoreCase) || string.Equals(profile.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "pill-success" : string.Equals(profile.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(profile.Status, "Awaiting Approval", StringComparison.OrdinalIgnoreCase) ? "pill-warning" : string.Equals(profile.Status, "Disabled", StringComparison.OrdinalIgnoreCase) ? "pill-danger" : "pill-neutral")">@profile.Status</span>
                                @if (string.Equals(profile.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="prototype-pill pill-warning ms-1">New Registration</span>
                                }
                                else if (string.Equals(profile.Status, "Awaiting Approval", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="prototype-pill pill-blue ms-1">Technician Approval</span>
                                }
                            </td>
                            <td>@profile.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <form asp-action="UpdateProfile" method="post" class="d-flex gap-2 justify-content-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@profile.Id" />
                                    <select name="role" class="form-select form-select-sm w-auto">
                                        <option value="Client" selected="@(profile.Role == "Client")">Client</option>
                                        <option value="Technician" selected="@(profile.Role == "Technician")">Technician</option>
                                        <option value="Admin" selected="@(profile.Role == "Admin")">Admin</option>
                                    </select>
                                    <select name="status" class="form-select form-select-sm w-auto">
                                        <option value="Active" selected="@(profile.Status == "Active")">Active</option>
                                        <option value="Pending" selected="@(string.Equals(profile.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(profile.Status, "Awaiting Approval", StringComparison.OrdinalIgnoreCase))">Pending</option>
                                        <option value="Disabled" selected="@(profile.Status == "Disabled")">Disabled</option>
                                        <option value="Approved" selected="@(profile.Status == "Approved")">Approved</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
