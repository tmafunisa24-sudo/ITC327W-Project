@model ServiceHub_IT.DTOs.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="hero-panel">
        <div>
            <span class="hero-badge"><i class="bi bi-people-fill"></i>Admin Access</span>
            <h1 class="h4 mb-2 mt-3">User Management</h1>
            <p class="text-muted mb-0">Approve, assign roles, and manage access for every ServiceHub IT account.</p>
        </div>
        <div class="topbar-pill"><i class="bi bi-shield-check me-2"></i>@Model.PendingApprovals pending approvals</div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success mt-4">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger mt-4">@error</div>
    }
    @if (TempData["Error"] is string detailedError)
    {
        <div class="alert alert-danger mt-2">@detailedError</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-3"><div class="card p-3 stat-card"><h6 class="text-muted">Total Users</h6><h2 class="mb-0">@Model.TotalUsers</h2></div></div>
        <div class="col-md-3"><div class="card p-3 stat-card"><h6 class="text-muted">Pending</h6><h2 class="mb-0">@Model.PendingApprovals</h2></div></div>
        <div class="col-md-3"><div class="card p-3 stat-card"><h6 class="text-muted">Clients</h6><h2 class="mb-0">@Model.Employees</h2></div></div>
        <div class="col-md-3"><div class="card p-3 stat-card"><h6 class="text-muted">Technicians & Admins</h6><h2 class="mb-0">@(Model.Technicians + Model.Administrators)</h2></div></div>
    </div>

    <div class="card p-4">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in Model.Profiles)
                    {
                        <tr>
                            <td>@profile.Email</td>
                            <td>@(!string.IsNullOrWhiteSpace(profile.FullName) ? profile.FullName : "—")</td>
                            <td>
                                <span class="badge bg-secondary">@profile.Role</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@profile.Status</span>
                            </td>
                            <td>@profile.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <form asp-action="UpdateProfile" method="post" class="d-flex gap-2 justify-content-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@profile.Id" />
                                    <select name="role" class="form-select form-select-sm w-auto">
                                        <option value="Client" selected="@(profile.Role == "Client")">Client</option>
                                        <option value="Technician" selected="@(profile.Role == "Technician")">Technician</option>
                                        <option value="Admin" selected="@(profile.Role == "Admin")">Admin</option>
                                    </select>
                                    <select name="status" class="form-select form-select-sm w-auto">
                                        <option value="Active" selected="@(profile.Status == "Active")">Active</option>
                                        <option value="Pending" selected="@(string.Equals(profile.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(profile.Status, "Awaiting Approval", StringComparison.OrdinalIgnoreCase))">Pending</option>
                                        <option value="Disabled" selected="@(profile.Status == "Disabled")">Disabled</option>
                                        <option value="Approved" selected="@(profile.Status == "Approved")">Approved</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
