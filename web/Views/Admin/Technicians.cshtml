@model IReadOnlyList<ServiceHub_IT.Models.Profile>
@{
    ViewData["Title"] = "Technician Management";
    Layout = "_Layout";
}

<div class="container-fluid admin-technicians-page">
    <header class="hero-header service-page-hero">
        <div>
            <span class="service-page-kicker">TEAM DIRECTORY</span>
            <h1>Technician Management</h1>
            <p>Manage technician roles and account access.</p>
        </div>
        <span class="prototype-pill pill-blue">@Model.Count technicians</span>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <section class="card-custom technicians-table-card" aria-label="Technicians">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="card-title">Technician</th>
                        <th class="card-title">Email</th>
                        <th class="card-title">Role</th>
                        <th class="card-title">Status</th>
                        <th class="card-title text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">No technician profiles found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var technician in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(technician.FullName) ? "Unnamed technician" : technician.FullName)</strong>
                                    @if (!string.IsNullOrWhiteSpace(technician.Position))
                                    {
                                        <div class="small text-muted">@technician.Position</div>
                                    }
                                </td>
                                <td>@technician.Email</td>
                                <td><span class="prototype-pill pill-blue">@technician.Role</span></td>
                                <td>
                                    <span class="prototype-pill @(string.Equals(technician.Status, "Active", StringComparison.OrdinalIgnoreCase) || string.Equals(technician.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "pill-success" : string.Equals(technician.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(technician.Status, "Awaiting Approval", StringComparison.OrdinalIgnoreCase) ? "pill-warning" : "pill-danger")">
                                        @technician.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        <form asp-action="UpdateTechnician" method="post" class="d-flex flex-wrap gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@technician.Id" />
                                            <select name="role" class="form-select form-select-sm" aria-label="Role for @technician.Email">
                                                <option value="Technician" selected="@(technician.Role == "Technician")">Technician</option>
                                                <option value="Admin" selected="@(technician.Role == "Admin")">Admin</option>
                                                <option value="Client" selected="@(technician.Role == "Client")">Client</option>
                                            </select>
                                            <select name="status" class="form-select form-select-sm" aria-label="Status for @technician.Email">
                                                <option value="Active" selected="@(technician.Status == "Active")">Active</option>
                                                <option value="Awaiting Approval" selected="@(technician.Status == "Awaiting Approval")">Awaiting Approval</option>
                                                <option value="Disabled" selected="@(technician.Status == "Disabled")">Disabled</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                        </form>
                                        <form asp-action="DeleteTechnician" method="post" data-confirm="true">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@technician.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
