@model IEnumerable<ServiceHub_IT.Models.Asset>
@{
    ViewData["Title"] = "Asset Management";
    Layout = "_Layout";
}

<div class="card shadow-sm border-0 rounded-4 p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h3 class="fw-semibold mb-1">Asset Management</h3>
            <p class="text-muted mb-0">Manage assets, assignments, and document uploads.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add Asset</a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input name="SearchTerm" class="form-control" placeholder="Search by asset name" />
        </div>
        <div class="col-md-3">
            <select name="Category" class="form-select">
                <option value="">All categories</option>
                <option value="Laptop">Laptop</option>
                <option value="Desktop">Desktop</option>
                <option value="Mobile">Mobile</option>
                <option value="Peripheral">Peripheral</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="Status" class="form-select">
                <option value="">All status</option>
                <option value="Available">Available</option>
                <option value="Assigned">Assigned</option>
                <option value="Maintenance">Maintenance</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Tag</th>
                    <th>Asset</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model)
                {
                    <tr>
                        <td>@asset.asset_tag</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.image_url))
                            {
                                <img src="@asset.image_url" alt="@asset.asset_name" class="rounded border me-2" style="width:48px;height:48px;object-fit:cover;" />
                            }
                            <div class="fw-semibold">@asset.asset_name</div>
                            <small class="text-muted">@asset.brand @asset.model</small>
                        </td>
                        <td>@asset.category</td>
                        <td><span class="badge bg-primary">@asset.status</span></td>
                        <td>@asset.assigned_employee</td>
                        <td>@asset.location</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@asset.id" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@asset.id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="Assign" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@asset.id" />
                                    <input type="text" name="employee" class="form-control form-control-sm d-inline-block" style="width: 120px;" placeholder="Client" />
                                    <button class="btn btn-sm btn-outline-success">Assign</button>
                                </form>
                                <form asp-action="Return" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@asset.id" />
                                    <button class="btn btn-sm btn-outline-secondary">Return</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@asset.id" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
