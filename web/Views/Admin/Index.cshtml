@model ServiceHub_IT.DTOs.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
    var performance = Model.TechnicianPerformance;
    var clientShare = Model.TotalUsers == 0 ? 0 : (int)Math.Round(Model.Employees * 100d / Model.TotalUsers);
}

<div class="dashboard-canvas admin-dashboard-page">
    <section class="prototype-hero">
        <div class="prototype-hero-copy">
            <div class="hero-kickers"><span class="hero-admin-pill">Administrator</span><span class="hero-tier-label">Service operations overview</span></div>
            <h2>Admin Dashboard</h2>
            <p>Full control over tickets, assets, staff and service delivery.</p>
        </div>
        <div class="telemetry-card">
            <span class="telemetry-icon"><i class="bi bi-pc-display-horizontal"></i></span>
            <span class="telemetry-copy"><small><i class="bi bi-circle-fill"></i> Workspace data</small><strong>ServiceHub IT</strong><em>Current records loaded</em></span>
        </div>
        <span class="hero-orb hero-orb-one"></span><span class="hero-orb hero-orb-two"></span>
    </section>

    <section class="prototype-section" aria-label="User identity directory">
        <header class="prototype-section-heading">
            <div class="prototype-section-name"><span>Users</span><i></i><small>Identity Directory</small></div>
            <a class="prototype-section-action" asp-controller="Admin" asp-action="Users">Manage directory <i class="bi bi-arrow-right"></i></a>
        </header>
        <div class="prototype-metric-grid prototype-user-grid">
            <article class="prototype-metric-card">
                <div class="prototype-metric-top"><span>Total users</span><i class="metric-icon metric-icon-blue bi bi-people"></i></div>
                <div class="prototype-metric-bottom"><strong class="metric-blue-text">@Model.TotalUsers</strong><small><i class="bi bi-people-fill text-success"></i> Across all roles</small></div>
            </article>
            <article class="prototype-metric-card">
                <div class="prototype-metric-top"><span>Pending approval</span><i class="metric-icon metric-icon-amber bi bi-hourglass-split"></i></div>
                <div class="prototype-metric-bottom"><strong class="metric-amber-text">@Model.PendingApprovals</strong><small><span class="prototype-pill pill-warning-dot">Action Required</span></small></div>
            </article>
            <article class="prototype-metric-card">
                <div class="prototype-metric-top"><span>Clients</span><i class="metric-icon metric-icon-slate bi bi-building"></i></div>
                <div class="prototype-metric-bottom"><strong>@Model.Employees</strong><small>@clientShare% of user directory</small></div>
            </article>
            <article class="prototype-metric-card">
                <div class="prototype-metric-top"><span>Technicians</span><i class="metric-icon metric-icon-violet bi bi-person-badge"></i></div>
                <div class="prototype-metric-bottom"><strong class="metric-violet-text">@Model.Technicians</strong><small>Service team accounts</small></div>
            </article>
        </div>
    </section>

    <div class="prototype-ticket-section">
        <section class="prototype-section" aria-label="Ticket incident queues">
            <header class="prototype-section-heading">
                <div class="prototype-section-name"><span>Tickets</span><i></i><small>Incident Queues</small></div>
                <a class="prototype-section-action" asp-controller="Tickets" asp-action="Index">View queue <i class="bi bi-arrow-right"></i></a>
            </header>
            <div class="prototype-metric-grid prototype-dual-grid">
                <article class="prototype-metric-card">
                    <div class="prototype-metric-top"><span>Resolved tickets</span><i class="metric-icon metric-icon-green bi bi-check-circle"></i></div>
                    <div class="prototype-metric-bottom"><strong class="metric-green-text">@Model.ResolvedTickets</strong><small><span class="prototype-pill pill-success">Resolved and closed</span></small></div>
                </article>
                <article class="prototype-metric-card">
                    <div class="prototype-metric-top"><span>Unresolved tickets</span><i class="metric-icon metric-icon-red bi bi-exclamation-triangle"></i></div>
                    <div class="prototype-metric-bottom"><strong class="metric-red-text">@Model.UnresolvedTickets</strong><small><span class="prototype-pill pill-danger">Requires attention</span></small></div>
                </article>
            </div>
        </section>
    </div>
</div>

<div class="admin-supporting-grid">
    <section class="supporting-card">
        <header class="supporting-card-heading"><div><span>Service team</span><h2>Technician performance</h2></div><i class="bi bi-activity"></i></header>
        <div class="table-responsive">
            <table class="table prototype-table align-middle mb-0">
                <thead><tr><th>Rank</th><th>Technician</th><th>Assigned tickets</th><th>Resolved</th><th>Avg. resolution</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < performance.Leaderboard.Count; i++)
                    {
                        var row = performance.Leaderboard[i];
                        <tr><td><span class="prototype-rank">@(i + 1)</span></td><td class="fw-semibold">@row.TechnicianName</td><td>@row.AssignedTickets</td><td>@row.ResolvedTickets</td><td>@row.AverageResolutionHours.ToString("0.0") hours</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="supporting-card">
        <header class="supporting-card-heading"><div><span>Latest activity</span><h2>Recent tickets</h2></div><i class="bi bi-ticket-perforated"></i></header>
        @if (Model.Tickets.Any())
        {
            <div class="table-responsive">
                <table class="table prototype-table align-middle mb-0">
                    <thead><tr><th>Ticket</th><th>Status</th><th>Assigned technician</th></tr></thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets.Take(8))
                        {
                            <tr><td><a class="prototype-ticket-link" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.id">@ticket.title</a></td><td><span class="prototype-status">@ticket.status</span></td><td>@(string.IsNullOrWhiteSpace(ticket.assigned_technician) ? (ticket.technician_id.HasValue ? "Assigned" : "Unassigned") : ticket.assigned_technician)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="prototype-empty-state"><i class="bi bi-inbox"></i><strong>No recent tickets</strong><span>New support requests will appear here.</span></div>
        }
    </section>
</div>

@section Scripts {
}
