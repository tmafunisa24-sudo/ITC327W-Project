@model IEnumerable<ServiceHub_IT.Models.Ticket>
@{
    ViewData["Title"] = "Help Desk";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Help Desk</h1>
        <p class="text-muted mb-0">Manage support requests and ticket lifecycle.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Ticket</a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Requester</th>
                    <th>Technician</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model)
                {
                    <tr>
                        <td>@ticket.title</td>
                        <td><span class="badge bg-info text-dark">@ticket.priority</span></td>
                        <td><span class="badge bg-secondary">@ticket.status</span></td>
                        <td>@ticket.requester</td>
                        <td>@ticket.assigned_technician</td>
                        <td>@ticket.created_at?.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@ticket.id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
