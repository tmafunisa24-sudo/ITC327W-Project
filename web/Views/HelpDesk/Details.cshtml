@model ServiceHub_IT.Models.Ticket
@{
    ViewData["Title"] = "Ticket Details";
    var prediction = ViewBag.AiPrediction as ServiceHub_IT.Models.TicketPrediction;
    var attachments = ViewBag.Attachments as IEnumerable<ServiceHub_IT.Models.TicketAttachment> ?? Enumerable.Empty<ServiceHub_IT.Models.TicketAttachment>();
    var isAdmin = User.IsInRole("Admin");
    var isTechnicianOnly = User.IsInRole("Technician") && !isAdmin;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h1 class="h4 mb-1">@Model.title</h1>
                        <p class="text-muted mb-0">@Model.description</p>
                    </div>
                    <span class="badge bg-primary">@Model.priority</span>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.status</dd>
                    <dt class="col-sm-4">Requester</dt>
                    <dd class="col-sm-8">@Model.requester</dd>
                    <dt class="col-sm-4">Assigned Technician</dt>
                    <dd class="col-sm-8">@Model.assigned_technician</dd>
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.category</dd>
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.created_at?.ToString("g")</dd>
                    <dt class="col-sm-4">Due Date</dt>
                    <dd class="col-sm-8">@(Model.due_date is null ? "Not set" : Model.due_date.Value.ToString("g"))</dd>
                    <dt class="col-sm-4">Payment Method</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.payment_method) ? "Not selected" : Model.payment_method)</dd>
                    <dt class="col-sm-4">Payment Status</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.payment_status) ? "Pending" : Model.payment_status)</dd>
                </dl>

                <div class="mt-3">
                    <h5>Screenshot</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.screenshot_url) || !string.IsNullOrWhiteSpace(Model.image_url))
                    {
                        var primaryImageUrl = !string.IsNullOrWhiteSpace(Model.screenshot_url) ? Model.screenshot_url : Model.image_url;
                        <img src="@primaryImageUrl" alt="Ticket image" class="img-fluid rounded border" style="max-height: 320px;" />
                        <div class="mt-2"><a href="@primaryImageUrl" target="_blank" rel="noopener">View Screenshot</a></div>
                    }
                    else
                    {
                        <div class="text-muted">No screenshot uploaded.</div>
                    }
                </div>
                @if (attachments.Any())
                {
                    <div class="mt-3">
                        <h5>Attached Images</h5>
                        <div class="row g-3">
                            @foreach (var attachment in attachments)
                            {
                                <div class="col-sm-6 col-md-4">
                                    <a href="@attachment.FileUrl" target="_blank" rel="noopener" aria-label="View @attachment.FileName">
                                        <img src="@attachment.FileUrl" alt="@attachment.FileName" class="img-fluid rounded border" style="max-height:180px; width:100%; object-fit:cover;" />
                                    </a>
                                    <div class="small text-muted mt-1 text-truncate">@attachment.FileName</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="mt-3">
                    <h5>Comments</h5>
                    @if (string.IsNullOrWhiteSpace(Model.comments))
                    {
                        <div class="text-muted">No comments yet.</div>
                    }
                    else
                    {
                        <div class="border rounded p-3" style="white-space: pre-line;">@Model.comments</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title">AI Recommendations</h5>
                @if (prediction is not null)
                {
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Predicted Priority:</strong> @prediction.Priority</li>
                        <li class="list-group-item"><strong>Estimated Resolution Time:</strong> @prediction.EstimatedResolutionHours hours</li>
                        <li class="list-group-item"><strong>Recommended Technician:</strong> @prediction.RecommendedTechnician</li>
                    </ul>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Update Ticket</h5>
                @if (isTechnicianOnly)
                {
                    <form asp-action="AcceptTicket" asp-route-id="@Model.id" method="post" class="mb-3">
                        <button type="submit" class="btn btn-outline-success w-100">Accept Ticket</button>
                    </form>
                }
                <form asp-action="UpdateStatus" asp-route-id="@Model.id" method="post">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            @if (!isTechnicianOnly)
                            {
                                <option selected="@(Model.status == "Open")">Open</option>
                                <option selected="@(Model.status == "Assigned")">Assigned</option>
                            }
                            <option selected="@(Model.status == "In Progress")">In Progress</option>
                            <option selected="@(Model.status == "Resolved")">Resolved</option>
                            <option selected="@(Model.status == "Closed")">Closed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Due Date</label>
                        <input name="DueDate" type="datetime-local" class="form-control" value="@(Model.due_date?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Comment</label>
                        <textarea name="Comment" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
