@model ServiceHub_IT.DTOs.DashboardMetricsDto
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var totalMetric = Math.Max(1, Model.TotalAssets + Model.OpenTickets + Model.MaintenanceDue);
    var assetsShare = Math.Round(Model.TotalAssets * 100.0 / totalMetric);
    var ticketsShare = Math.Round(Model.OpenTickets * 100.0 / totalMetric);
    var maintenanceShare = Math.Round(Model.MaintenanceDue * 100.0 / totalMetric);
    var pieGradient = Model.TotalAssets + Model.OpenTickets + Model.MaintenanceDue <= 0
        ? "background: conic-gradient(#cbd5e1 0 100%);"
        : $"background: conic-gradient(#2563eb 0 {assetsShare}%, #14b8a6 {assetsShare}% {assetsShare + ticketsShare}%, #f43f5e {assetsShare + ticketsShare}% 100%);";
}

<div class="container-fluid px-0">
    <div class="page-section">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 fw-semibold mb-1">Operations Overview</h2>
                <p class="text-muted mb-0">A polished snapshot of IT operations across assets, tickets, and support teams.</p>
            </div>
            <div class="topbar-pill"><i class="bi bi-clock-history me-2"></i>Live status</div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Total Assets</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalAssets</h2>
                    </div>
                    <div class="badge bg-primary-subtle text-primary fs-4"><i class="bi bi-hdd-stack"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Assigned Assets</h6>
                        <h2 class="fw-bold mb-0">@Model.AssignedAssets</h2>
                    </div>
                    <div class="badge bg-info-subtle text-info fs-4"><i class="bi bi-person-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Available Assets</h6>
                        <h2 class="fw-bold mb-0">@Model.AvailableAssets</h2>
                    </div>
                    <div class="badge bg-success-subtle text-success fs-4"><i class="bi bi-check-circle"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Clients</h6>
                        <h2 class="fw-bold mb-0">@Model.Employees</h2>
                    </div>
                    <div class="badge bg-secondary-subtle text-secondary fs-4"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Technicians</h6>
                        <h2 class="fw-bold mb-0">@Model.Technicians</h2>
                    </div>
                    <div class="badge bg-warning-subtle text-warning fs-4"><i class="bi bi-tools"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Open Tickets</h6>
                        <h2 class="fw-bold mb-0">@Model.OpenTickets</h2>
                    </div>
                    <div class="badge bg-danger-subtle text-danger fs-4"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Closed Tickets</h6>
                        <h2 class="fw-bold mb-0">@Model.ClosedTickets</h2>
                    </div>
                    <div class="badge bg-success-subtle text-success fs-4"><i class="bi bi-check2-circle"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-2">Maintenance Due</h6>
                        <h2 class="fw-bold mb-0">@Model.MaintenanceDue</h2>
                    </div>
                    <div class="badge bg-dark-subtle text-dark fs-4"><i class="bi bi-tools"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card p-4 h-100 fade-in">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-semibold mb-0">Service Mix</h5>
                    <span class="topbar-pill"><i class="bi bi-pie-chart-fill me-2"></i>Live</span>
                </div>
                <div class="row align-items-center g-4">
                    <div class="col-md-6">
                        <div class="pie-chart" style="@pieGradient"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center justify-content-between border-bottom pb-2">
                                <span><i class="bi bi-hdd-stack me-2 text-primary"></i>Assets</span>
                                <strong>@Model.TotalAssets</strong>
                            </div>
                            <div class="d-flex align-items-center justify-content-between border-bottom pb-2">
                                <span><i class="bi bi-exclamation-triangle me-2 text-success"></i>Open Tickets</span>
                                <strong>@Model.OpenTickets</strong>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-tools me-2 text-danger"></i>Maintenance Due</span>
                                <strong>@Model.MaintenanceDue</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
